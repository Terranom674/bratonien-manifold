<div>
  Der folgende <%= @kind %>-Inhalt in <a href="<%= @resource.subject_url %>"><%= sanitize @resource.project.title %></a> wurde <%= @resource.flags_count %>-mal gemeldet.

  <div>
    <p style="margin-top: 15px; margin-bottom: 0;">
      <em><%= @resource.body %></em>
    </p>
  </div>

  <% if @message %>
    <div style="margin-top: 30px; margin-bottom: 30px;">
      <span style="display: block; margin-top: 15px;">
        Bei der letzten Meldung hat der Benutzer folgenden Kommentar hinzugefügt:
      </span>
      <p><em><%= @message %></em></p>
    </div>
  <% end %>
</div>
