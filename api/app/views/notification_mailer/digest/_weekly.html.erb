Hier ist deine wöchentliche <strong>Manifold</strong>-Aktivitätsübersicht:

<% labels = { "Text" => ["Text", "Texte"], "Resource" => ["Ressource", "Ressourcen"], "Collection" => ["Sammlung", "Sammlungen"], "Annotation" => ["Annotation", "Annotationen"], "Comment" => ["Kommentar", "Kommentare"] } %>
<div>
  <ul class="event-list">
    <% @projects&.each do |project, events| %>
      <% project = project.decorate %>
      <li>
        <% counted = events.group_by(&:subject_type).map { |type, list| label = labels.fetch(type, [type, type.pluralize]); "#{list.length} #{list.length == 1 ? label.first : label.last}" } %>
        <% counted_sentence = counted.length > 1 ? "#{counted[0...-1].join(', ')} und #{counted.last}" : counted.first %>
        <%= counted_sentence %> zu <a href="<%= project.url %>"><%= project.title %></a> hinzugefügt
      </li>
    <% end %>

    <% @annotations_and_comments&.each do |project, events| %>
      <% project = project.decorate %>
      <li>
        <% counted = events.group_by(&:subject_type).map { |type, list| label = labels.fetch(type, [type, type.pluralize]); "#{list.length} #{list.length == 1 ? label.first : label.last}" } %>
        <% counted_sentence = counted.length > 1 ? "#{counted[0...-1].join(', ')} und #{counted.last}" : counted.first %>
        <%= counted_sentence %> zu <a href="<%= project.url %>"><%= project.title %></a> hinzugefügt
      </li>
    <% end %>
  </ul>
</div>
