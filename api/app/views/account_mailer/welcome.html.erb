<% if @created_by_admin %>
  <p>
    Willkommen bei <%= @installation_name %>.
  </p>
  <p>
    Ein Administrator hat ein Benutzerkonto für dich erstellt. Deine Zugangsdaten lauten:
  </p>
  <p>
    <strong>E-Mail:</strong> <%= @user.email %><br />
    <strong>Passwort:</strong> <%= @user.password %>
  </p>
<% else %>
  <p>
    Willkommen bei <%= @installation_name %>. Danke für deine Registrierung!
  </p>
<% end %>
<p>
  Bitte <%= link_to "bestätige deine E-Mail-Adresse", @email_confirmation_url %>.
</p>
<p>
  Nach der Anmeldung kannst du Projekttexte annotieren und deine Annotationen ansehen.
  Außerdem kannst du dich an Diskussionen über Texte und Projektressourcen beteiligen.
</p>
